# Copy to .env and fill in real values. NEVER commit .env.
DATABASE_URL=postgresql://user:password@host:5432/energicast
JWT_SECRET=replace_with_strong_secret   # >= 32 random chars, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
MODEL_STORAGE_PATH=./models
CORS_ORIGINS=http://localhost:5173,https://energy-cast.vercel.app

# Optional (defaults shown)
DATA_STORAGE_PATH=./data
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=500
VALIDATION_TIMEOUT_SECONDS=600  # 10 minutes for large dataset validation
PROCESSING_TIMEOUT_SECONDS=600  # 10 minutes for large dataset processing

# Optional (defaults shown)
DATA_STORAGE_PATH=./data
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=500

# --- Render free tier (512 MB RAM): set these as environment variables on the service, not in this file ---
# MALLOC_ARENA_MAX=2
# OMP_NUM_THREADS=1
# WEB_CONCURRENCY=1
